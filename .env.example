# Petal backend — copy to .env.local (gitignored) and fill in.
# Local dev/test DB uses in-process PGlite (no value needed). DATABASE_URL is for
# a real Postgres (Supabase cloud) at runtime / cloud migrations.
DATABASE_URL=

# Supabase (cloud) — for runtime + Storage + Auth (clients OTP). Provision later.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk — firm/preparer auth (Organizations enabled). Needed at Task 5.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Anthropic — AI orchestration (ZDR + no-training via DPA; direct, no LangChain).
ANTHROPIC_API_KEY=

# DEV-ONLY: run Petal's AI on a GPT-5.5 endpoint via a local Codex-subscription proxy (e.g.
# router-for-me/CLIProxyAPI, after `codex login`). UNSANCTIONED, against OpenAI ToS, and ban-risky
# on your personal account; SYNTHETIC/demo data ONLY. Never set in prod — the provider factory
# throws if PETAL_DEV_INFERENCE=codex-sub is seen while NODE_ENV=production. Prod always uses
# Anthropic. Validate the live proxy first: npx tsx scripts/validate-codex-provider.ts
# PETAL_DEV_INFERENCE=codex-sub
# PETAL_DEV_OPENAI_BASE_URL=http://127.0.0.1:8317/v1
# PETAL_DEV_OPENAI_MODEL=gpt-5.5
# PETAL_DEV_OPENAI_REASONING=high

# PII envelope encryption master key (KEK), 32 bytes base64. In prod use KMS /
# Supabase Vault. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
