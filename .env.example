# Petal backend — copy to .env.local (gitignored) and fill in.
# Local dev/test DB uses in-process PGlite (no value needed). DATABASE_URL is for
# a real Postgres (Supabase cloud) at runtime / cloud migrations.
DATABASE_URL=

# Supabase (cloud) — for runtime + Storage + Auth (clients OTP). Provision later.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk — firm/preparer auth (Organizations enabled). Needed at Task 5.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Anthropic — AI orchestration (ZDR + no-training via DPA; direct, no LangChain).
ANTHROPIC_API_KEY=

# DEV-ONLY cost saver: route Petal's AI through your Claude Code SUBSCRIPTION instead of
# billing API tokens while testing LOCALLY. Get the token with `claude setup-token`. NEVER set
# these in prod/CI, and only run synthetic/demo data through this path (it is NOT the ZDR/BAA
# path — real client data must use ANTHROPIC_API_KEY). Leave unset to use the API normally.
# AI_PROVIDER=claude-code
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# ANTHROPIC_OAUTH_BETA=oauth-2025-04-20   # only if the default OAuth beta header is rejected

# PII envelope encryption master key (KEK), 32 bytes base64. In prod use KMS /
# Supabase Vault. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
