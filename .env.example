# Petal backend — copy to .env.local (gitignored) and fill in.
# Local dev/test DB uses in-process PGlite (no value needed). DATABASE_URL is for
# a real Postgres (Supabase cloud) at runtime / cloud migrations.
DATABASE_URL=

# Supabase (cloud) — for runtime + Storage + Auth (clients OTP). Provision later.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk — firm/preparer auth (Organizations enabled). Needed at Task 5.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Anthropic — AI orchestration (ZDR + no-training via DPA; direct, no LangChain).
ANTHROPIC_API_KEY=

# DEV-ONLY cost saver: force every AI call to the cheapest ZDR model while testing LOCALLY
# (same API key, same ZDR posture, ~12x cheaper than Opus). Unset in prod/CI so production keeps
# its real per-call models. (Routing dev through a Claude Code Max subscription token is NOT
# possible: Anthropic blocks sk-ant-oat01 tokens from any use outside Claude Code itself.)
# PETAL_DEV_MODEL=claude-haiku-4-5

# PII envelope encryption master key (KEK), 32 bytes base64. In prod use KMS /
# Supabase Vault. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
