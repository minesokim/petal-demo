  { cite: "IRC §2523", url: lii("2523"), type: "statute", taxYear: [2024, 2025, 2026], note: "GIFT-TAX MARITAL DEDUCTION — an UNLIMITED deduction in computing taxable gifts for gifts to a spouse who is a US citizen (terminable-interest limits apply); for a NON-citizen spouse there is no marital deduction but an increased annual exclusion instead" },
  { cite: "IRC §1223", url: lii("1223"), type: "statute", taxYear: [2024, 2025, 2026], note: "HOLDING PERIOD — tacking rules: property with a substituted/carryover basis tacks the prior holding period; a gift tacks the donor's holding period; property acquired from a decedent (§1014 basis) is automatically treated as held LONG-TERM regardless of actual time held" },
  { cite: "IRC §6213", url: lii("6213"), type: "statute", taxYear: [2024, 2025, 2026], note: "DEFICIENCY PROCEDURES — before assessing a deficiency the IRS must mail a NOTICE OF DEFICIENCY (the 90-day letter); the taxpayer may petition the Tax Court within 90 days (150 if addressed outside the US), and assessment/collection is generally BARRED until the Tax Court decision is final" },
  { cite: "IRC §6330", url: lii("6330"), type: "statute", taxYear: [2024, 2025, 2026], note: "COLLECTION DUE PROCESS — before levying, the IRS must give written notice of the right to a CDP HEARING before an impartial Appeals officer, where the taxpayer may raise collection alternatives, spousal defenses, and (if no prior opportunity) the underlying liability; the determination is reviewable by the Tax Court" },
  { cite: "IRC §55", url: lii("55"), type: "statute", taxYear: [2024, 2025, 2026], note: "ALTERNATIVE MINIMUM TAX — imposes a tax equal to the excess of the TENTATIVE MINIMUM TAX over the regular tax; the tentative minimum tax is computed on alternative minimum taxable income (AMTI) above an exemption amount, at 26% / 28% for noncorporate taxpayers (a flat 15% corporate AMT on adjusted financial statement income for applicable corporations)" },
  { cite: "IRC §59", url: lii("59"), type: "statute", taxYear: [2024, 2025, 2026], note: "AMT — other definitions and special rules: the alternative minimum tax foreign tax credit, treatment of certain AMT items, and the rules coordinating the exemption phase-out and the minimum tax credit (§53)" },
  // ── EMPTY-AREA DISTILL batch 5 (outbound/§1248/deemed-credit, estate inclusion powers/joint/special-use, accounting cash/LIFO/LTC, collection/summons) ──
  { cite: "IRC §367", url: lii("367"), type: "statute", taxYear: [2024, 2025, 2026], note: "OUTBOUND TRANSFERS — overrides corporate nonrecognition: a US person's transfer of property to a FOREIGN corporation in a §351/§361 exchange triggers gain recognition (the foreign corporation is not treated as a corporation), with exceptions for active-business assets and gain-recognition agreements; §367(d) reaches transfers of intangibles" },
  { cite: "IRC §1248", url: lii("1248"), type: "statute", taxYear: [2024, 2025, 2026], note: "SALE OF CFC STOCK — gain on a US shareholder's sale or exchange of stock in a controlled foreign corporation is recharacterized as a DIVIDEND to the extent of the earnings and profits of the foreign corporation attributable to the stock accumulated while the shareholder held it" },
  { cite: "IRC §960", url: lii("960"), type: "statute", taxYear: [2024, 2025, 2026], note: "DEEMED-PAID FOREIGN TAX CREDIT — a domestic corporation that has a Subpart F or GILTI inclusion is treated as having PAID the foreign income taxes properly attributable to that inclusion, giving it an indirect foreign tax credit (subject to the §904 limitation and the GILTI haircut)" },
  { cite: "IRC §2035", url: lii("2035"), type: "statute", taxYear: [2024, 2025, 2026], note: "ADJUSTMENTS FOR GIFTS WITHIN 3 YEARS OF DEATH — the gross estate is increased by the GIFT TAX PAID on gifts made within 3 years of death (the gross-up rule), and certain transfers within 3 years of death (e.g., of life insurance or retained-interest property under §§2036-2038, 2042) are pulled back into the gross estate" },
  { cite: "IRC §2038", url: lii("2038"), type: "statute", taxYear: [2024, 2025, 2026], note: "REVOCABLE TRANSFERS — the gross estate includes property the decedent transferred where, at death, the enjoyment was subject to a power (alone or with another) to ALTER, AMEND, REVOKE, or TERMINATE the transfer" },
  { cite: "IRC §2040", url: lii("2040"), type: "statute", taxYear: [2024, 2025, 2026], note: "JOINT INTERESTS — the gross estate includes the FULL value of property held in joint tenancy with right of survivorship, EXCEPT the portion shown to be attributable to the surviving co-tenant's own contribution; for a QUALIFIED JOINT INTEREST between spouses, exactly one-half is included regardless of contribution" },
  { cite: "IRC §2041", url: lii("2041"), type: "statute", taxYear: [2024, 2025, 2026], note: "POWERS OF APPOINTMENT — the gross estate includes property over which the decedent held a GENERAL power of appointment at death (a power exercisable in favor of the decedent, the estate, or its creditors); a power limited by an ascertainable standard (health, education, support, maintenance) is NOT a general power" },
  { cite: "IRC §2032A", url: lii("2032A"), type: "statute", taxYear: [2024, 2025, 2026], note: "SPECIAL-USE VALUATION — qualified real property used in farming or a closely-held trade or business may be valued at its actual farm/business USE value rather than highest-and-best-use, reducing the gross estate by up to an inflation-indexed cap; recapture tax applies if the heir disposes of it or stops the qualified use within 10 years" },
  { cite: "IRC §448", url: lii("448"), type: "statute", taxYear: [2024, 2025, 2026], note: "LIMITATION ON CASH METHOD — C corporations, partnerships with a C-corp partner, and tax shelters generally may NOT use the cash receipts and disbursements method, EXCEPT a small business meeting the gross-receipts test (average annual gross receipts under an inflation-indexed threshold) and a qualified personal service corporation" },
  { cite: "IRC §460", url: lii("460"), type: "statute", taxYear: [2024, 2025, 2026], note: "LONG-TERM CONTRACTS — income from a long-term contract (not completed in the year entered) must generally be reported under the PERCENTAGE-OF-COMPLETION method with a lookback interest computation; exceptions exist for home-construction contracts and small construction contractors under the gross-receipts threshold" },
  { cite: "IRC §472", url: lii("472"), type: "statute", taxYear: [2024, 2025, 2026], note: "LIFO INVENTORY — a taxpayer may elect the last-in, first-out method of identifying inventory (newest costs to cost of goods sold first); if LIFO is used for tax, the LIFO CONFORMITY rule requires it also be used in financial statements issued to owners/creditors" },
  { cite: "IRC §6502", url: lii("6502"), type: "statute", taxYear: [2024, 2025, 2026], note: "COLLECTION AFTER ASSESSMENT — where an assessment has been timely made, the tax may be collected by levy or court proceeding only if begun within 10 YEARS after the assessment (the collection statute expiration date), subject to suspensions and agreed extensions" },
  { cite: "IRC §7602", url: lii("7602"), type: "statute", taxYear: [2024, 2025, 2026], note: "EXAMINATION AND SUMMONS AUTHORITY — to determine the correctness of a return or a tax liability, the IRS may examine books, papers, and records and may issue a SUMMONS compelling the taxpayer or third parties to appear, produce records, and give testimony under oath" },
  // ── EMPTY-AREA DISTILL batch 6 (TARGETED at the benchmark's remaining IRC gaps — gap-map driven) ──
  { cite: "IRC §121", url: lii("121"), type: "statute", taxYear: [2024, 2025, 2026], note: "EXCLUSION OF GAIN ON A PRINCIPAL RESIDENCE — a taxpayer may exclude up to $250,000 ($500,000 for a married couple filing jointly) of gain from the sale of a home owned AND used as the principal residence for at least 2 of the 5 years before the sale; the full exclusion is available only once every 2 years (a reduced exclusion applies for a sale due to a change in employment, health, or unforeseen circumstances)" },
  { cite: "IRC §108", url: lii("108"), type: "statute", taxYear: [2024, 2025, 2026], note: "DISCHARGE OF INDEBTEDNESS — cancellation-of-debt income is EXCLUDED from gross income if the discharge occurs in a Title 11 (bankruptcy) case, or while the taxpayer is INSOLVENT (limited to the amount of insolvency), or for qualified farm, real-property-business, or principal-residence indebtedness; excluded amounts REDUCE tax attributes (NOLs, credits, basis) under §108(b)" },
  { cite: "IRC §368", url: lii("368"), type: "statute", taxYear: [2024, 2025, 2026], note: "REORGANIZATIONS — defines the tax-free reorganization types: (A) statutory merger/consolidation, (B) stock-for-stock, (C) stock-for-substantially-all-assets, (D) divisive/acquisitive transfer to a controlled corp, (E) recapitalization, (F) mere change in identity/form, (G) bankruptcy; judicial doctrines of continuity of interest, continuity of business enterprise, and business purpose also must be met" },
  { cite: "IRC §381", url: lii("381"), type: "statute", taxYear: [2024, 2025, 2026], note: "CARRYOVERS IN CERTAIN ACQUISITIONS — in a §332 subsidiary liquidation or a §368 reorganization (A/C/D/F/G), the acquiring corporation SUCCEEDS TO and takes into account the target's enumerated tax attributes — net operating loss carryovers, earnings and profits, accounting methods, capital loss carryovers, and credits — subject to the §382/§383 limitations" },
  { cite: "IRC §1031", url: lii("1031"), type: "statute", taxYear: [2024, 2025, 2026], note: "LIKE-KIND EXCHANGES — no gain or loss is recognized on the exchange of REAL PROPERTY held for productive use in a trade or business or for investment for like-kind real property (post-2017, §1031 applies ONLY to real property, not personal property); receipt of money or non-like-kind property (BOOT) triggers gain; a deferred exchange must identify replacement property within 45 days and close within 180 days" },
  { cite: "IRC §453", url: lii("453"), type: "statute", taxYear: [2024, 2025, 2026], note: "INSTALLMENT METHOD — income from an installment sale (at least one payment received after the year of sale) is reported as payments are received: each payment's taxable gain equals the payment times the GROSS PROFIT RATIO (gross profit / total contract price); not available for inventory, dealer dispositions, or publicly traded property; §453A imposes interest on large deferred balances" },
  { cite: "IRC §1296", url: lii("1296"), type: "statute", taxYear: [2024, 2025, 2026], note: "PFIC MARK-TO-MARKET ELECTION — a US person owning MARKETABLE stock of a passive foreign investment company may ELECT to include annually in ordinary income the excess of year-end fair market value over adjusted basis (and deduct decreases, limited to prior mark-to-market gains), as an alternative to the §1291 interest-charge regime" },
  { cite: "IRC §663", url: lii("663"), type: "statute", taxYear: [2024, 2025, 2026], note: "SPECIAL RULES FOR TRUST/ESTATE DISTRIBUTIONS — §663(a)(1): a gift or bequest of a SPECIFIC sum of money or specific property paid in three or fewer installments does NOT carry out distributable net income (DNI); §663(b): a trust or estate may ELECT to treat distributions made within the first 65 DAYS of the year as paid on the last day of the preceding year" },
  { cite: "IRC §2632", url: lii("2632"), type: "statute", taxYear: [2024, 2025, 2026], note: "ALLOCATION OF THE GST EXEMPTION — a transferor's GST exemption is AUTOMATICALLY allocated to direct skips, and to indirect skips to a GST trust, unless the transferor elects out; an allocation may also be made on a gift-tax return; the allocation determines the trust's inclusion ratio (and thus its exposure to GST tax)" },
  { cite: "IRC §6501", url: lii("6501"), type: "statute", taxYear: [2024, 2025, 2026], note: "ASSESSMENT STATUTE OF LIMITATIONS — tax must generally be ASSESSED within 3 YEARS after the return is filed (or its due date if later); the period is 6 YEARS if there is a substantial omission of gross income (more than 25%); and there is NO time limit for a false or fraudulent return, a willful attempt to evade, or a failure to file" },
  { cite: "IRC §4958", url: lii("4958"), type: "statute", taxYear: [2024, 2025, 2026], note: "EXCESS BENEFIT TRANSACTIONS (intermediate sanctions) — a 25% excise tax is imposed on a DISQUALIFIED PERSON who receives an excess economic benefit from a §501(c)(3) or (c)(4) organization (200% additional tax if not corrected), plus a 10% tax on organization managers who knowingly approved the transaction; a rebuttable presumption of reasonableness applies if proper procedures are followed" },
  { cite: "IRC §513", url: lii("513"), type: "statute", taxYear: [2024, 2025, 2026], note: "UNRELATED TRADE OR BUSINESS — any trade or business the conduct of which is not SUBSTANTIALLY RELATED (aside from the need for funds) to the organization's exempt purpose; EXCLUDED are a business in which substantially all the work is done by volunteers, one carried on for the convenience of members/students/patients, and the selling of donated merchandise" },
  { cite: "IRC §41", url: lii("41"), type: "statute", taxYear: [2024, 2025, 2026], note: "CREDIT FOR INCREASING RESEARCH ACTIVITIES — a credit equal to 20% of the excess of qualified research expenses over a base amount, OR the alternative simplified credit of 14% of QRE over 50% of the average QRE for the prior 3 years; qualified research expenses are in-house wages and supplies for qualified research plus 65% of contract research expenses" },
  // IRC §1202 (QSBS) — DISABLED pending a fix. The figure-grounded chunk is correct on the tiers
  // but the LII operative text refers to "the applicable date" WITHOUT pinning it to a calendar date,
  // and the "OBBBA enacted July 4, 2025" fact lives in a chunk a QSBS query doesn't co-retrieve. Result:
  // the model can't place a pre-July-2025 acquisition and CONFIDENTLY MISCLASSIFIES it (gave 75% where
  // the answer is $0 for a 4-yr hold on March-2025 stock). A confident wrong answer is worse than the
  // honest abstain, so this stays out until the applicable-date definition (= OBBBA enactment, 7/4/2025)
  // is grounded INTO this chunk and/or co-retrieved. See ask-once.mts to reproduce.
  // { cite: "IRC §1202", url: lii("1202"), type: "statute", taxYear: [2025, 2026], note: "QSBS gain exclusion — capture the applicable-date DEFINITION (= date of enactment of OBBBA / P.L. 119-21) explicitly, not just the term." },
];

// A figure's NUMERIC CORE (digits only) — so "3.8%", "3.8 percent", and "$3.8" all compare equal,
// and "$125,000" matches "125,000". The gate grounds the NUMBER, tolerant of unit formatting.
function figureCores(text: string): string[] {
  return [...text.matchAll(/\$?\d[\d,]*(?:\.\d+)?\s?%?|\b(?:19|20)\d{2}\b/g)]
    .map((m) => m[0].replace(/[^\d.]/g, ""))
    .filter((n) => n.length >= 2 && n !== "."); // ignore single digits / noise
}
function norm(s: string): string { return s.replace(/[^\d.]/g, ""); } // digits-and-dots stream of the source

async function fetchSource(url: string, anchor?: string): Promise<string> {
  const res = await fetch(url, { headers: { "user-agent": "PetalAuthorityIngest/1.0 (tax-research corpus)" } });
  if (!res.ok) throw new Error(`fetch ${res.status}`);
  const raw = await res.text();
  // Strip scripts/styles/tags to plain text; collapse whitespace.
  const stripped = raw
    .replace(/<script[\s\S]*?<\/script>/gi, " ")
    .replace(/<style[\s\S]*?<\/style>/gi, " ")
    .replace(/<[^>]+>/g, " ")
    .replace(/&[a-z]+;/gi, " ")
    .replace(/\s+/g, " ")
    .trim();
  // RE-CENTER the 24000-char window on the cited rule when it's buried past the cap (the §163(j)/§1.409A-1
  // fix) — keeps the distill grounded in the ACTUAL subsection instead of letting the cap drop it.
  if (anchor) {
    const i = stripped.toLowerCase().indexOf(anchor.toLowerCase());
    if (i >= 0) { const start = Math.max(0, i - 4000); return stripped.slice(start, start + 24000); }
    throw new Error(`anchor not found: "${anchor.slice(0, 40)}"`); // fail loud, don't silently ingest the wrong window
  }
  return stripped.slice(0, 24000);
}

const SYS = `You ingest US tax PRIMARY AUTHORITY into a research corpus. From the provided source text of ONE provision, write a single concise "operative rule" paraphrase a tax preparer could rely on. RULES: use ONLY facts/figures present in the provided text — never add a number, threshold, rate, or year from your own knowledge; if the text doesn't state a figure, don't include it. Public-domain factual paraphrase (statute isn't copyrightable). Output STRICT JSON only: {"text": string (the operative-rule paraphrase, 2-5 sentences), "keywords": string[] (8-15 lowercase retrieval terms incl. the section number and key concepts), "effectiveDate": "YYYY-MM-DD" (when this rule took effect; use the provided text or a conservative Jan 1 of the earliest listed tax year)}.`;

async function buildChunk(t: Target, provider: AIProvider): Promise<AuthorityChunk | null> {
  const source = await fetchSource(t.url, t.anchor);
  const { text: out } = await provider.generateText({
    system: SYS,
    prompt: `Citation: ${t.cite}\nHint: ${t.note}\nTax years this should serve: ${t.taxYear.join(", ")}\n\nSOURCE TEXT:\n${source}`,
    maxTokens: 700,
  });
  let parsed: { text: string; keywords: string[]; effectiveDate: string };
  try { parsed = JSON.parse(out.slice(out.indexOf("{"), out.lastIndexOf("}") + 1)); }
  catch { console.log(`✗ ${t.cite}: non-JSON output`); return null; }

  // GROUNDING GATE: every figure's numeric core in the paraphrase must appear in the fetched source.
  const src = norm(source);
  const ungrounded = figureCores(parsed.text).filter((f) => !src.includes(f));
  if (ungrounded.length) { console.log(`✗ ${t.cite}: ungrounded figures ${ungrounded.join(", ")} (rejected)`); return null; }

  const chunk: AuthorityChunk = {
    chunkId: `ingested-${t.cite.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "")}`,
    authorityType: t.type,
    citation: t.cite,
    jurisdiction: "federal",
    taxYear: t.taxYear,
    effectiveDate: parsed.effectiveDate || `${Math.min(...t.taxYear)}-01-01`,
    sourceUrl: t.url,
    ingestedAt: new Date().toISOString(),
    text: parsed.text,
    keywords: [...new Set(parsed.keywords.map((k) => k.toLowerCase()))],
    // Post-Loper-Bright delegation strength — wakes the §6662 weighting engine's DELEGATION_FACTOR for regs.
    ...(t.delegationBasis ? { delegationBasis: t.delegationBasis } : {}),
  };
  const v = authorityChunkSchema.safeParse(chunk);
  if (!v.success) { console.log(`✗ ${t.cite}: schema ${v.error.issues[0]?.message}`); return null; }
  console.log(`✓ ${t.cite}: ${chunk.text.slice(0, 90)}…`);
  return chunk;
}

async function main() {
  const write = process.argv.includes("--write");
  // Optional section filter: non-flag args restrict which TARGETS run (e.g. `... 30D 6050W`). With
  // --write + a filter, the new chunks are MERGED into the existing corpus (existing ones kept, not
  // re-paraphrased); with --write and no filter, the whole file is regenerated from all TARGETS.
  const only = process.argv.slice(2).filter((a) => !a.startsWith("--"));
  // EXACT section match (not substring) — "312" must select ONLY §312, never §3121; required for safe BULK runs.
  // Strips the IRC / Treas. Reg. prefix so a reg arg like "1.6662-4" selects "Treas. Reg. §1.6662-4".
  const sectionOf = (cite: string) => cite.replace(/^(IRC|Treas\.?\s*Reg\.?|Reg\.?|Prop\.?\s*Reg\.?)\s*§?\s*/i, "").trim().toLowerCase();
  const targets = only.length ? TARGETS.filter((t) => only.some((o) => sectionOf(t.cite) === o.toLowerCase())) : TARGETS;
  // Provider via the FACTORY so ingestion honors PETAL_DEV_INFERENCE=codex-sub (runs on the codex sub, not
  // the metered Anthropic key). The figure-grounding gate below guards correctness regardless of model.
  const provider = getProvider("claude-sonnet-4-6");
  const out: AuthorityChunk[] = [];
  for (const t of targets) {
    try { const c = await buildChunk(t, provider); if (c) out.push(c); }
    catch (e) { console.log(`✗ ${t.cite}: ${e instanceof Error ? e.message : e}`); }
  }
  console.log(`\n${out.length}/${targets.length} chunks passed the grounding gate.`);

  if (write) {
    // Merge into the existing corpus when a filter was used (keep the others); else full regenerate.
    let final = out;
    if (only.length) {
      const { CORPUS_INGESTED } = (await import("../lib/research/corpus-ingested.ts")) as { CORPUS_INGESTED: AuthorityChunk[] };
      const byId = new Map(CORPUS_INGESTED.map((c) => [c.chunkId, c]));
      for (const c of out) byId.set(c.chunkId, c);
      final = [...byId.values()];
    }
    const { writeFileSync } = await import("node:fs");
    const file =
      `// AUTO-GENERATED by scripts/ingest-authority.mts — re-run to refresh; do not hand-edit.\n` +
      `// Grounded primary-authority chunks: each is a concise operative-rule paraphrase produced\n` +
      `// FROM the fetched source text, and every $/%/year figure was verified to appear in that\n` +
      `// source before admission. Public domain (statute) — §7216-clean. Registered in authority/store.ts.\n` +
      `import type { AuthorityChunk } from "../tax/authority/store";\n\n` +
      `export const CORPUS_INGESTED: AuthorityChunk[] = ${JSON.stringify(final, null, 2)};\n`;
    writeFileSync("lib/research/corpus-ingested.ts", file);
    console.log(`wrote lib/research/corpus-ingested.ts (${final.length} chunks)`);
  } else {
    console.log("(dry run — pass --write to emit lib/research/corpus-ingested.ts)");
  }
}
main().catch((e) => { console.error(e); process.exit(1); });
